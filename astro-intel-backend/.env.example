# Copy this to .env and fill in real values — never commit .env to git

# ── LLM Provider (at least one required) ──────────────────────────────────────
OPENAI_API_KEY=sk-...
DEEPSEEK_API_KEY=sk-...

# ── Auth (REQUIRED — change before production) ────────────────────────────────
# MASTER_API_KEY is your SUPERADMIN key — the only person who can create tenants
# Generate a strong random value: python3 -c "import secrets; print('sk-master-' + secrets.token_hex(24))"
MASTER_API_KEY=sk-master-astrointel-change-me

# JWT secret — signs all Bearer tokens
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=astrointel-jwt-secret-change-in-production

# JWT token TTL in seconds (default 24h = 86400)
JWT_TTL_SECONDS=86400

# ── Email (optional — enables report delivery to user's inbox) ────────────────
# Uses Gmail SMTP. In Gmail: Security → 2-Step Verification → App Passwords → generate one.
# Without these, emails are skipped silently — the app still works fully.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-gmail-app-password
EMAIL_FROM=AURA with Rav <your-gmail@gmail.com>

# ── Superadmin login credentials ──────────────────────────────────────────────
SUPERADMIN_EMAIL=admin@aura.local
SUPERADMIN_PASSWORD=AuraAdmin2024!
PW_SALT=astrointel-pw-salt-change-me

# ── URLs (REQUIRED in production) ────────────────────────────────────────────
# Set APP_URL to your deployed frontend URL so email links work correctly
APP_URL=http://localhost:4200
# Set ALLOWED_ORIGINS to your deployed frontend domain (comma-separated)
# ALLOWED_ORIGINS=https://aura.yourdomain.com

# ── Environment mode ──────────────────────────────────────────────────────────
# Set APP_ENV=production to enforce strong secrets at startup
APP_ENV=development

# ── Optional tuning ───────────────────────────────────────────────────────────
# Where auth keys persist (set automatically by docker-compose via volume)
# AUTH_STORE_PATH=/data/auth_keys.json
