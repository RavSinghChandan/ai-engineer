# ── LLM ──────────────────────────────────────────────
LLM_PROVIDER=deepseek          # deepseek | anthropic
DEEPSEEK_API_KEY=your_deepseek_key_here
DEEPSEEK_MODEL=deepseek-chat

ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Instagram ─────────────────────────────────────────
INSTAGRAM_ACCESS_TOKEN=your_instagram_page_access_token
INSTAGRAM_APP_SECRET=your_meta_app_secret
INSTAGRAM_VERIFY_TOKEN=salesflow_verify      # any secret string you choose
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id

# ── Database ──────────────────────────────────────────
DATABASE_PATH=./salesflow.db                 # SQLite (default)
# DATABASE_URL=postgresql://user:pass@host/db  # Phase 4 upgrade

# ── Server ────────────────────────────────────────────
PORT=8000
