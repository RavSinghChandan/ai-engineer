# ===== AI Content Factory — backend configuration =====
# Copy to .env and fill in secrets. Never commit .env.

ENVIRONMENT=development
DEBUG=true
SECRET_KEY=generate-a-long-random-string

# Local-first database (swap to postgresql+asyncpg://user:pass@host/db later)
# DATABASE_URL=sqlite+aiosqlite:///./data/acf.db

# --- LLM ---
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# OPENAI_API_KEY=

# --- TTS fallback (per-person voice lives in Creator Profiles, not here) ---
TTS_PROVIDER=macos_say
MACOS_VOICE=Samantha
# Key must have text_to_speech + voices_read permissions:
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Avatar (per-person avatar_id lives in Creator Profiles, not here) ---
# HEYGEN_API_KEY=

# --- CORS ---
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
