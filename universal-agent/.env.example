# Copy this file to .env and fill in your values
# Never commit .env to version control

# Required — choose one based on your LLM provider
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...

# Optional — only needed if tools.web_search.enabled: true
# TAVILY_API_KEY=tvly-...

# Optional — override config file location
# AGENT_CONFIG_PATH=./config/agent.config.yaml

# Optional — log level
LOG_LEVEL=INFO
