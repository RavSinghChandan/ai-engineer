# Copy to backend/.env and fill in locally. Never commit the real .env.
# On Replit, set these in Secrets instead of using a file.

# Optional. Without it the app runs fully offline and ad copy comes from the
# built-in template library. With it, ad copy is generated per campaign.
DEEPSEEK_API_KEY=

# Optional overrides.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
