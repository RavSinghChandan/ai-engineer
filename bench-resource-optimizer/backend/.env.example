# ── LLM Registry — Multi-Model Routing ──────────────────────────────────────
# Each pipeline task is routed to the best model for that task.
# Right now all tasks fall back to DeepSeek. Set the keys below to unlock
# specialized models task by task. No code change needed — just add the key.
#
# Task           Current model          Target model (once key added)
# ─────────────────────────────────────────────────────────────────────────
# reasoning      deepseek-reasoner      deepseek-reasoner (R1 — already best)
# parsing        deepseek-chat          claude-haiku-4-5  (fastest JSON extract)
# generation     deepseek-chat          gpt-4o / gemini-1.5-pro (creative plans)
# judging        deepseek-chat          claude-opus-4-8 / gpt-4o (strict grading)
# embedding      deepseek-chat          cohere embed-english-v3 (best semantic search)
# ─────────────────────────────────────────────────────────────────────────

# Active — required
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Pending — parsing specialist (Claude Haiku — fastest structured extraction)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Pending — generation specialist (GPT-4o — creative long-form plans)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1

# Pending — generation / long-context (Gemini 1.5 Pro — 1M token window)
# GOOGLE_API_KEY=your_google_api_key_here
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Pending — embedding specialist (Cohere embed-english-v3 — best role/skill matching)
# COHERE_API_KEY=your_cohere_api_key_here

# ── App Config ───────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRY_SECONDS=86400
ADMIN_PASSWORD=your_admin_password_here
DEFAULT_USER_PASSWORD=your_user_password_here
REDIS_URL=redis://localhost:6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CV_TOPIC=bench.cv.uploaded
KAFKA_PLAN_TOPIC=bench.plan.requested
KAFKA_DLQ_TOPIC=bench.dlq
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:4200
