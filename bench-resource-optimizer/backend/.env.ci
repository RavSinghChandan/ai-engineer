# CI environment — used by GitHub Actions bench-ci.yml
# DEEPSEEK_API_KEY is intentionally absent: all LLM calls are mocked in tests.
# SQLite uses pytest tmp_path fixtures: no real DB file is created or required.

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LOG_LEVEL=WARNING
CORS_ORIGINS=http://localhost:4200
