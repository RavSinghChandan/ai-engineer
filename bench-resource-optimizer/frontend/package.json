{
  "name": "bench-optimizer-ui",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "jest --coverage",
    "test:ci": "jest --coverage --ci --reporters=default"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.0",
    "@angular/common": "^17.3.0",
    "@angular/compiler": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@angular/forms": "^17.3.0",
    "@angular/platform-browser": "^17.3.0",
    "@angular/platform-browser-dynamic": "^17.3.0",
    "@angular/router": "^17.3.0",
    "ag-grid-angular": "^31.3.2",
    "ag-grid-community": "^31.3.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.0",
    "@angular/cli": "^17.3.0",
    "@angular/compiler-cli": "^17.3.0",
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.1.4",
    "typescript": "~5.4.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "moduleNameMapper": {
      "^@angular/core$": "<rootDir>/node_modules/@angular/core",
      "^@angular/common$": "<rootDir>/node_modules/@angular/common",
      "^@angular/common/http$": "<rootDir>/node_modules/@angular/common/http",
      "^@angular/router$": "<rootDir>/node_modules/@angular/router",
      "^rxjs$": "<rootDir>/node_modules/rxjs",
      "^rxjs/(.*)$": "<rootDir>/node_modules/rxjs/$1"
    },
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.spec.json",
          "diagnostics": false
        }
      ]
    },
    "testMatch": [
      "**/*.spec.ts"
    ],
    "collectCoverageFrom": [
      "src/app/services/**/*.ts",
      "!src/app/**/*.module.ts"
    ]
  }
}
