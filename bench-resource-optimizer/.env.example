# ── Copy this to .env and fill in real values ─────────────────────────────────
# cp .env.example .env

# ── LLM ───────────────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-256-bit-secret-in-production
JWT_EXPIRY_SECONDS=86400
ADMIN_PASSWORD=change-me-in-production
DEFAULT_USER_PASSWORD=bench123
# Optional: the project managers in backend/data/ontology.json (pm.meera, pm.dev) log in with it
PROJECT_MANAGER_PASSWORD=change-me-in-production

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CV_TOPIC=bench.cv.uploaded
KAFKA_PLAN_TOPIC=bench.plan.requested
KAFKA_DLQ_TOPIC=bench.dlq

# ── App ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:4200
