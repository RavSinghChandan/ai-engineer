# ── LLM ──────────────────────────────────────────────────────────
LLM_PROVIDER=deepseek           # deepseek | anthropic
DEEPSEEK_API_KEY=your_deepseek_key_here
DEEPSEEK_MODEL=deepseek-chat

ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Database ──────────────────────────────────────────────────────
DATABASE_PATH=./runbookai.db    # SQLite for Phase 1; PostgreSQL in Phase 6

# ── Auth ─────────────────────────────────────────────────────────
# REQUIRED — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_at_least_32_random_chars
ACCESS_TOKEN_EXPIRE_SECONDS=86400   # 24 hours

# ── App environment ───────────────────────────────────────────────
APP_ENV=production   # set to "test" in CI to skip JWT_SECRET requirement

# ── CORS ─────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:4200,https://yourdomain.com

# ── Server ────────────────────────────────────────────────────────
PORT=8000
